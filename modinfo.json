{
  "$schema": "https://gitee.com/SC-SPM/SurvivalcraftApi/raw/SCAPI1.9/Survivalcraft/Content/modinfo-scheme.json",
  "Name": "Voice Prompt Core 语音提示核心",
  "Version": "1.0.1",
  "ApiVersion": "1.9.3",
  "Description": "Core of the gameplay-prompt voice system: intercepts prompt texts (hunger, cold, sleepiness, etc), resolves the language key and plays the matching voice from the selected audio pack. Voice packs are resource-only mods with PackageName starting with 'voice.prompt.pack.' and audio at Assets/Audio/Voice/<packId>/. 游戏弹出提示时按文本反查语言键位，并播放当前选中语音包里的对应语音。本模组只含逻辑不含音频，需配合语音音频包使用。设置文案多语言见 Assets/Lang/。",
  "ScVersion": "2.4.0.0",
  "LoadOrder": 10000,
  "NonPersistentMod": true,
  "GameplayImpactLevel": "Cosmetic",
  "Author": "ShuiMo",
  "PackageName": "VoicePrompt.core",
  "Dependencies": {},
  "Settings": [
    {
      "Id": "VoicePrompt",
      "Items": [
        {
          "Id": "Enable",
          "Type": "bool",
          "Default": true,
          "Widget": "BoolButtonSettingWidget"
        },
        {
          "Id": "VoicePack",
          "Type": "string",
          "Default": "",
          "Widget": "Game.VoicePackSelectionWidget"
        },
        {
          "Id": "Volume",
          "Type": "float",
          "Default": 1.0,
          "Widget": "NumberSliderSettingWidget",
          "WidgetProperties": {
            "MinValue": 0,
            "MaxValue": 2,
            "Granularity": 0.05
          }
        },
        {
          "Id": "Cooldown",
          "Type": "int",
          "Default": 5,
          "Widget": "NumberSliderSettingWidget",
          "WidgetProperties": {
            "MinValue": 0,
            "MaxValue": 300,
            "Granularity": 5
          }
        }
      ]
    }
  ]
}
