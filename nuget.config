<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<!-- NuGet 包缓存放在仓库同级目录（../nuget-packages），不写入用户主目录，也不进仓库 -->
		<add key="global-packages-folder" value="..\nuget-packages"/>
	</config>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
		<add key="SurvivalcraftAPI" value="https://nuget.fury.io/survivalcraftapi"/>
	</packageSources>
</configuration>
